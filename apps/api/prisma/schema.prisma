generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  MANAGER
  STYLIST
  ESTHETICIAN
  ASSISTANT
  ROOM_RESOURCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
  WAITLIST
}

enum ReservationSource {
  LINE
  MINI_APP
  WEB
  PHONE
  WALK_IN
}

enum ShiftType {
  AVAILABLE
  OFF
  BREAK
  SALES_STOP
  TRAINING
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  REFUNDED
}

enum LineMessageStatus {
  NOT_SENT
  QUEUED
  SENT
  READ
  FAILED
}

enum CategoryType {
  MENU
  OPTION
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Tenant {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  status      TenantStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  auditLogs   AuditLog[]
  invitations TenantInvitation[]
  memberships TenantMembership[]
  salons      Salon[]
}

model AppUser {
  chartRevisionsCreated TreatmentChartRevision[] @relation("ChartRevisionCreator")
  chartRevisionsFinalized TreatmentChartRevision[] @relation("ChartRevisionFinalizer")
  id              String             @id @default(cuid())
  firebaseUid     String             @unique
  email           String?            @unique
  displayName     String?
  disabled        Boolean            @default(false)
  lastSignedInAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  auditLogs       AuditLog[]         @relation("AuditActor")
  invitationsSent TenantInvitation[] @relation("InvitationSender")
  memberships     TenantMembership[]
}

model TenantMembership {
  useCustomPermissions Boolean @default(false)
  permissions String[] @default([])
  salonIds String[] @default([])
  tenantId  String
  userId    String
  role      TenantRole       @default(STAFF)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId, status])
}

model TenantInvitation {
  useCustomPermissions Boolean @default(false)
  permissions String[] @default([])
  salonIds String[] @default([])
  revokedAt DateTime?
  id              String     @id @default(cuid())
  tenantId        String
  email           String
  role            TenantRole @default(STAFF)
  tokenHash       String     @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime   @default(now())
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       AppUser    @relation("InvitationSender", fields: [invitedByUserId], references: [id])

  @@index([tenantId, email])
  @@index([email, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       AppUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

model Salon {
  customerImportRuns CustomerImportRun[]
  treatmentCharts TreatmentChart[]
  cashCheckouts CashCheckout[]
  cashRegisterSessions CashRegisterSession[]
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  timezone      String         @default("Asia/Tokyo")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categories    MenuCategory[]
  customers     Customer[]
  equipment     Equipment[]
  notifications Notification[]
  reservations  Reservation[]
  services      Service[]
  settings      SalonSettings?
  shifts        Shift[]
  staff         Staff[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model Staff {
  externalRecords StaffExternalRecord[]
  treatmentCharts TreatmentChart[]
  id               String        @id @default(cuid())
  tenantId         String
  salonId          String
  name             String
  kana             String
  role             StaffRole
  color            String
  imageUrl         String?
  nominationFee    Int           @default(0)
  comment          String?
  allocationOrder  Int           @default(1)
  parallelCapacity Int           @default(1)
  active           Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  reservations     Reservation[]
  salon            Salon         @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)
  shifts           Shift[]

  @@unique([tenantId, salonId, id])
  @@index([tenantId, salonId, sortOrder])
}

// Use a displayed SalonBoard publication staff ID when available. Older captures
// can use a name/kana snapshot key and may require manual rename reconciliation.
model StaffExternalRecord {
  id                String   @id @default(cuid())
  tenantId          String
  salonId           String
  staffId           String
  source            String
  sourceStoreId     String
  externalRecordKey String
  profile           Json
  importedAt        DateTime @default(now())
  staff             Staff    @relation(fields: [tenantId, salonId, staffId], references: [tenantId, salonId, id], onDelete: Cascade)

  @@unique([tenantId, salonId, source, sourceStoreId, externalRecordKey])
  @@index([tenantId, salonId, staffId])
}

model Service {
  id               String        @id @default(cuid())
  tenantId         String
  salonId          String
  name             String
  category         String
  imageUrl         String?
  description      String        @default("")
  durationMinutes  Int
  price            Int
  color            String
  menuType         String        @default("通常メニュー")
  lineVisible      Boolean       @default(true)
  unlimitedBooking Boolean       @default(true)
  sortOrder        Int           @default(0)
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  reservations     Reservation[]
  salon            Salon         @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, salonId, id])
  @@index([tenantId, salonId, category])
}

model MenuCategory {
  id          String       @id @default(cuid())
  tenantId    String
  salonId     String
  name        String
  type        CategoryType @default(MENU)
  description String       @default("")
  imageUrl    String?
  enabled     Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  salon       Salon        @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, salonId, type, sortOrder])
}

model Equipment {
  id              String   @id @default(cuid())
  tenantId        String
  salonId         String
  name            String
  capacity        Int      @default(1)
  allocationOrder Int      @default(1)
  color           String   @default("#18c7bd")
  memo            String   @default("")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  salon           Salon    @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, salonId, sortOrder])
}

model SalonSettings {
  id                        String   @id @default(cuid())
  tenantId                  String
  salonId                   String
  storeId                   String
  openTime                  String   @default("09:00")
  closeTime                 String   @default("22:00")
  closedDays                String[] @default([])
  maxConcurrentReservations Int      @default(7)
  bookingWindowType         String   @default("month")
  bookingWindowValue        String   @default("1ヶ月先")
  reservationCutoffMode     String   @default("previous_day")
  reservationCutoffHours    Float    @default(0)
  reservationCutoffDays     Int      @default(1)
  reservationCutoffTime     String   @default("21:30")
  cancellationCutoffMode    String   @default("previous_day")
  cancellationCutoffHours   Float    @default(0)
  cancellationCutoffDays    Int      @default(1)
  cancellationCutoffTime    String   @default("21:30")
  multiMenuBooking          Boolean  @default(true)
  autoAssignUnspecified     Boolean  @default(true)
  lineThemeColor            String   @default("#ff0000")
  categoryDisplayMode       String   @default("collapsed")
  candidateIntervalMinutes  Int      @default(30)
  calendarDefaultView       String   @default("week")
  calendarDisplayMode       String   @default("collapsed")
  notifyReservationEmail    Boolean  @default(true)
  notifyReservationLine     Boolean  @default(false)
  notifyCancellation        Boolean  @default(true)
  notifyCancellationEmail   Boolean  @default(true)
  notifyCancellationLine    Boolean  @default(false)
  cancellationMessage       String
  friendMessage             String
  preReservationMessage     String   @default("")
  questionsEnabled          Boolean  @default(false)
  paymentEnabled            Boolean  @default(false)
  acceptingReservations     Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  salon                     Salon    @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, salonId])
}

model Customer {
  externalRecords CustomerExternalRecord[]
  treatmentCharts TreatmentChart[]
  id              String        @id @default(cuid())
  tenantId        String
  salonId         String
  name            String
  kana            String
  phone           String?
  lineDisplayName String?
  tags            String[]      @default([])
  visitCount      Int           @default(0)
  totalSpent      Int           @default(0)
  lastVisitAt     DateTime?
  memo            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reservations    Reservation[]
  salon           Salon         @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, salonId, id])
  @@index([tenantId, salonId, kana])
}

// Imported identifiers remain independent of editable customer names and telephone numbers.
model CustomerExternalRecord {
  id                 String   @id @default(cuid())
  tenantId           String
  salonId            String
  customerId         String
  source             String
  sourceStoreId      String
  externalCustomerId String
  profile            Json
  importedAt         DateTime @default(now())
  customer           Customer @relation(fields: [tenantId, salonId, customerId], references: [tenantId, salonId, id], onDelete: Cascade)

  @@unique([tenantId, salonId, source, sourceStoreId, externalCustomerId])
  @@index([tenantId, salonId, customerId])
}

// The manifest contains hashes only. Customer data is sent in bounded, retryable chunks.
model CustomerImportRun {
  id               String   @id @default(cuid())
  tenantId         String
  salonId          String
  source           String
  sourceStoreId    String
  capturedAt       DateTime
  expectedCount    Int
  checksum         String
  recordHashes     String[]
  processedOffsets Int[]    @default([])
  createdCount     Int      @default(0)
  skippedCount     Int      @default(0)
  createdByUserId   String
  createdAt        DateTime @default(now())
  completedAt      DateTime?
  salon            Salon    @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, salonId, source, sourceStoreId, checksum])
  @@index([tenantId, salonId, createdAt])
}

model Reservation {
  treatmentCharts TreatmentChart[]
  cashCheckouts CashCheckout[]
  @@unique([tenantId, salonId, id])
  id                String            @id @default(cuid())
  tenantId          String
  salonId           String
  staffId           String?
  customerId        String
  serviceId         String
  startsAt          DateTime
  endsAt            DateTime
  status            ReservationStatus @default(PENDING)
  source            ReservationSource @default(LINE)
  isRequest         Boolean           @default(false)
  memo              String?
  riskScore         Int               @default(0)
  paymentStatus     PaymentStatus     @default(UNPAID)
  lineMessageStatus LineMessageStatus @default(NOT_SENT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customer          Customer          @relation(fields: [tenantId, salonId, customerId], references: [tenantId, salonId, id])
  salon             Salon             @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)
  service           Service           @relation(fields: [tenantId, salonId, serviceId], references: [tenantId, salonId, id])
  staff             Staff?            @relation(fields: [tenantId, salonId, staffId], references: [tenantId, salonId, id])

  @@index([tenantId, salonId, startsAt])
  @@index([tenantId, staffId, startsAt])
  @@index([tenantId, customerId])
}

model Shift {
  id        String    @id @default(cuid())
  tenantId  String
  salonId   String
  staffId   String?
  label     String
  type      ShiftType
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salon     Salon     @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)
  staff     Staff?    @relation(fields: [tenantId, salonId, staffId], references: [tenantId, salonId, id])

  @@index([tenantId, salonId, startsAt])
  @@index([tenantId, staffId, startsAt])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  salonId   String
  kind      String
  title     String
  body      String
  severity  String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  salon     Salon     @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, salonId, readAt])
}

enum CashCheckoutStatus {
  DRAFT
  FINALIZED
  REVERSED
}

enum CashPaymentMethod {
  CASH
  CARD
  BANK
  EXTERNAL_PREPAYMENT
  OTHER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementKind {
  IN
  OUT
  SALE
  REFUND
}

model CashCheckout {
  id                       String             @id @default(uuid())
  tenantId                 String
  salonId                  String
  reservationId            String
  supersedesCheckoutId     String?
  finalizedSessionId       String?
  reversedSessionId        String?
  status                   CashCheckoutStatus @default(DRAFT)
  version                  Int                @default(1)
  reservationSnapshot      Json
  legacyPaymentStatus      String
  legacyPaidAcknowledged   Boolean            @default(false)
  subtotalYen              Int                @default(0)
  discountYen              Int                @default(0)
  taxYen                   Int                @default(0)
  taxBreakdown             Json
  totalYen                 Int                @default(0)
  cashYen                  Int                @default(0)
  notes                    String             @default("")
  createRequestId          String
  finalizeRequestId        String?
  finalizeRequestHash      String?
  reverseRequestId         String?
  reverseRequestHash       String?
  finalizedAt              DateTime?
  reversedAt               DateTime?
  reversalReason           String?
  createdByUserId          String
  finalizedByUserId        String?
  reversedByUserId         String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  salon                    Salon              @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  reservation              Reservation        @relation(fields: [tenantId, salonId, reservationId], references: [tenantId, salonId, id], onDelete: Restrict)
  items                    CashCheckoutItem[]
  payments                 CashPaymentAllocation[]
  movements                CashRegisterMovement[]
  supersedesCheckout       CashCheckout? @relation("CashCorrections", fields: [tenantId, salonId, supersedesCheckoutId], references: [tenantId, salonId, id], onDelete: Restrict)
  corrections              CashCheckout[] @relation("CashCorrections")
  finalizedSession         CashRegisterSession? @relation("CashFinalizations", fields: [tenantId, salonId, finalizedSessionId], references: [tenantId, salonId, id], onDelete: Restrict)
  reversedSession          CashRegisterSession? @relation("CashReversals", fields: [tenantId, salonId, reversedSessionId], references: [tenantId, salonId, id], onDelete: Restrict)

  @@unique([tenantId, salonId, id])
  @@index([tenantId, salonId, reservationId])
  @@unique([tenantId, salonId, createRequestId])
  @@unique([tenantId, salonId, finalizeRequestId])
  @@unique([tenantId, salonId, reverseRequestId])
  @@index([tenantId, salonId, createdAt])
}

model CashCheckoutItem {
  id           String       @id @default(uuid())
  tenantId     String
  salonId      String
  checkoutId   String
  lineNumber   Int
  label        String
  quantity     Int
  unitPriceYen Int
  discountYen  Int
  taxRate      Int
  taxYen       Int
  totalYen     Int
  checkout     CashCheckout @relation(fields: [tenantId, salonId, checkoutId], references: [tenantId, salonId, id], onDelete: Restrict)

  @@unique([tenantId, salonId, checkoutId, lineNumber])
  @@index([tenantId, salonId, checkoutId])
}

model CashPaymentAllocation {
  id         String            @id @default(uuid())
  tenantId   String
  salonId    String
  checkoutId String
  method     CashPaymentMethod
  amountYen  Int
  reference  String            @default("")
  checkout   CashCheckout      @relation(fields: [tenantId, salonId, checkoutId], references: [tenantId, salonId, id], onDelete: Restrict)

  @@index([tenantId, salonId, checkoutId])
}

model CashRegisterSession {
  id                  String             @id @default(uuid())
  tenantId            String
  salonId             String
  businessDate        String
  status              CashRegisterStatus @default(OPEN)
  version             Int                @default(1)
  openingCashYen      Int
  expectedCashYen     Int?
  countedCashYen      Int?
  differenceYen       Int?
  note                String             @default("")
  closeSnapshot       Json?
  createRequestId     String
  closeRequestId      String?
  closeRequestHash    String?
  openedByUserId      String
  closedByUserId      String?
  openedAt           DateTime           @default(now())
  closedAt           DateTime?
  salon               Salon              @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  movements           CashRegisterMovement[]
  finalizedCheckouts  CashCheckout[] @relation("CashFinalizations")
  reversedCheckouts   CashCheckout[] @relation("CashReversals")

  @@unique([tenantId, salonId, id])
  @@unique([tenantId, salonId, businessDate])
  @@unique([tenantId, salonId, createRequestId])
  @@unique([tenantId, salonId, closeRequestId])
  @@index([tenantId, salonId, status])
}

model CashRegisterMovement {
  id               String              @id @default(uuid())
  tenantId         String
  salonId          String
  sessionId        String
  checkoutId       String?
  kind             CashMovementKind
  amountYen        Int
  reason           String
  requestId        String
  requestHash      String
  createdByUserId  String
  createdAt        DateTime            @default(now())
  session          CashRegisterSession @relation(fields: [tenantId, salonId, sessionId], references: [tenantId, salonId, id], onDelete: Restrict)
  checkout         CashCheckout?       @relation(fields: [tenantId, salonId, checkoutId], references: [tenantId, salonId, id], onDelete: Restrict)

  @@unique([tenantId, salonId, requestId])
  @@index([tenantId, salonId, sessionId, createdAt])
}

// Add the following inverse fields to existing models:
// Salon: treatmentCharts TreatmentChart[]
// Reservation: treatmentCharts TreatmentChart[]
// Reservation: @@unique([tenantId, salonId, id])
// Customer: treatmentCharts TreatmentChart[]
// Staff: treatmentCharts TreatmentChart[]
// AppUser:
//   chartRevisionsCreated TreatmentChartRevision[] @relation("ChartRevisionCreator")
//   chartRevisionsFinalized TreatmentChartRevision[] @relation("ChartRevisionFinalizer")
// Clinical records restrict deletion of linked reservations/customers/staff.
// Author user deletion sets author id null; the display-name snapshot is retained.

enum TreatmentChartStatus {
  DRAFT
  FINALIZED
}

enum TreatmentChartPhotoPhase {
  BEFORE
  AFTER
}

model TreatmentChart {
  id                    String   @id @default(cuid())
  tenantId              String
  salonId               String
  reservationId         String
  customerId            String
  staffId               String?
  customerName          String
  staffName             String?
  serviceId             String
  serviceName           String
  startsAt              DateTime
  endsAt                DateTime
  version               Int      @default(1)
  currentRevisionNumber Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  salon                 Salon       @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  reservation           Reservation @relation(fields: [tenantId, salonId, reservationId], references: [tenantId, salonId, id], onDelete: Restrict)
  customer              Customer    @relation(fields: [tenantId, salonId, customerId], references: [tenantId, salonId, id], onDelete: Restrict)
  staff                 Staff?      @relation(fields: [tenantId, salonId, staffId], references: [tenantId, salonId, id], onDelete: Restrict)
  revisions             TreatmentChartRevision[]
  photos                TreatmentChartPhoto[]

  @@unique([tenantId, salonId, id])
  @@unique([tenantId, salonId, reservationId])
  @@index([tenantId, salonId, customerId, startsAt])
  @@index([tenantId, salonId, updatedAt])
}

model TreatmentChartRevision {
  id                     String               @id @default(cuid())
  tenantId               String
  salonId                String
  chartId                String
  revisionNumber         Int
  status                 TreatmentChartStatus @default(DRAFT)
  treatmentAt            DateTime
  bodyParts              String[]             @default([])
  performedServiceDetail String               @default("")
  machine                String               @default("")
  outputJ                String               @default("")
  pulseWidth             String               @default("")
  skinObservations       String               @default("")
  productsMaterials      String               @default("")
  aftercareNotes         String               @default("")
  nextVisitPlan          String               @default("")
  amendmentReason        String?
  createdByUserId        String?
  createdByName          String?
  finalizedByUserId      String?
  finalizedByName        String?
  finalizedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  chart                  TreatmentChart       @relation(fields: [tenantId, salonId, chartId], references: [tenantId, salonId, id], onDelete: Restrict)
  createdBy              AppUser?             @relation("ChartRevisionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  finalizedBy            AppUser?             @relation("ChartRevisionFinalizer", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  photoLinks             TreatmentChartRevisionPhoto[]

  @@unique([tenantId, salonId, chartId, id])
  @@unique([tenantId, salonId, chartId, revisionNumber])
}

model TreatmentChartPhoto {
  id        String                   @id @default(cuid())
  tenantId  String
  salonId   String
  chartId   String
  phase     TreatmentChartPhotoPhase
  mimeType  String
  width     Int
  height    Int
  byteSize  Int
  // Existing database-backed photos remain readable until explicitly migrated.
  data                   Bytes?                   @db.ByteA
  storageBucket          String?
  storagePath            String?
  storageGeneration      String?
  storageDeletePendingAt DateTime?
  bodyPart               String?
  note                   String?
  capturedAt             DateTime?
  createdAt DateTime                 @default(now())
  chart     TreatmentChart           @relation(fields: [tenantId, salonId, chartId], references: [tenantId, salonId, id], onDelete: Restrict)
  revisionLinks TreatmentChartRevisionPhoto[]

  @@unique([tenantId, salonId, chartId, id])
  @@index([tenantId, salonId, chartId])
  @@index([storageDeletePendingAt])
}

model TreatmentChartRevisionPhoto {
  tenantId   String
  salonId    String
  chartId    String
  revisionId String
  photoId    String
  revision   TreatmentChartRevision @relation(fields: [tenantId, salonId, chartId, revisionId], references: [tenantId, salonId, chartId, id], onDelete: Restrict)
  photo      TreatmentChartPhoto    @relation(fields: [tenantId, salonId, chartId, photoId], references: [tenantId, salonId, chartId, id], onDelete: Restrict)

  @@id([tenantId, salonId, chartId, revisionId, photoId])
  @@index([tenantId, salonId, chartId, photoId])
}
