generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  MANAGER
  STYLIST
  ESTHETICIAN
  ASSISTANT
  ROOM_RESOURCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
  WAITLIST
}

enum ReservationSource {
  LINE
  MINI_APP
  WEB
  PHONE
  WALK_IN
}

enum ShiftType {
  AVAILABLE
  OFF
  BREAK
  SALES_STOP
  TRAINING
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  REFUNDED
}

enum LineMessageStatus {
  NOT_SENT
  QUEUED
  SENT
  READ
  FAILED
}

enum CategoryType {
  MENU
  OPTION
}

model Salon {
  id            String         @id @default(cuid())
  name          String
  timezone      String         @default("Asia/Tokyo")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categories    MenuCategory[]
  customers     Customer[]
  equipment     Equipment[]
  notifications Notification[]
  reservations  Reservation[]
  services      Service[]
  settings      SalonSettings?
  shifts        Shift[]
  staff         Staff[]
}

model Staff {
  id           String        @id @default(cuid())
  salonId      String
  name         String
  kana         String
  role         StaffRole
  color        String
  imageUrl     String?
  nominationFee Int          @default(0)
  comment      String?
  allocationOrder Int        @default(1)
  parallelCapacity Int       @default(1)
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  shifts       Shift[]

  @@index([salonId, sortOrder])
}

model Service {
  id              String        @id @default(cuid())
  salonId         String
  name            String
  category        String
  imageUrl        String?
  description     String        @default("")
  durationMinutes Int
  price           Int
  color           String
  menuType        String        @default("通常メニュー")
  lineVisible     Boolean       @default(true)
  unlimitedBooking Boolean      @default(true)
  sortOrder       Int           @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reservations    Reservation[]
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, category])
}

model MenuCategory {
  id          String       @id @default(cuid())
  salonId     String
  name        String
  type        CategoryType @default(MENU)
  description String       @default("")
  imageUrl    String?
  enabled     Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, type, sortOrder])
}

model Equipment {
  id              String   @id @default(cuid())
  salonId         String
  name            String
  capacity        Int      @default(1)
  allocationOrder Int      @default(1)
  color           String   @default("#18c7bd")
  memo            String   @default("")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, sortOrder])
}

model SalonSettings {
  id                         String   @id @default(cuid())
  salonId                    String   @unique
  storeId                    String
  openTime                   String   @default("09:00")
  closeTime                  String   @default("22:00")
  closedDays                 String[] @default([])
  maxConcurrentReservations  Int      @default(7)
  bookingWindowType          String   @default("month")
  bookingWindowValue         String   @default("1ヶ月先")
  reservationCutoffMode      String   @default("previous_day")
  reservationCutoffHours     Float    @default(0)
  reservationCutoffDays      Int      @default(1)
  reservationCutoffTime      String   @default("21:30")
  cancellationCutoffMode     String   @default("previous_day")
  cancellationCutoffHours    Float    @default(0)
  cancellationCutoffDays     Int      @default(1)
  cancellationCutoffTime     String   @default("21:30")
  multiMenuBooking           Boolean  @default(true)
  autoAssignUnspecified      Boolean  @default(true)
  lineThemeColor             String   @default("#ff0000")
  categoryDisplayMode        String   @default("collapsed")
  candidateIntervalMinutes   Int      @default(30)
  calendarDefaultView        String   @default("week")
  calendarDisplayMode        String   @default("collapsed")
  notifyReservationEmail     Boolean  @default(true)
  notifyReservationLine      Boolean  @default(false)
  notifyCancellation         Boolean  @default(true)
  notifyCancellationEmail    Boolean  @default(true)
  notifyCancellationLine     Boolean  @default(false)
  cancellationMessage        String
  friendMessage              String
  preReservationMessage      String   @default("")
  questionsEnabled           Boolean  @default(false)
  paymentEnabled             Boolean  @default(false)
  acceptingReservations      Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  salon                      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Customer {
  id              String        @id @default(cuid())
  salonId         String
  name            String
  kana            String
  phone           String?
  lineDisplayName String?
  tags            String[]      @default([])
  visitCount      Int           @default(0)
  totalSpent      Int           @default(0)
  lastVisitAt     DateTime?
  memo            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reservations    Reservation[]
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, kana])
}

model Reservation {
  id                String            @id @default(cuid())
  salonId           String
  staffId           String?
  customerId        String
  serviceId         String
  startsAt          DateTime
  endsAt            DateTime
  status            ReservationStatus @default(PENDING)
  source            ReservationSource @default(LINE)
  isRequest         Boolean           @default(false)
  memo              String?
  riskScore         Int               @default(0)
  paymentStatus     PaymentStatus     @default(UNPAID)
  lineMessageStatus LineMessageStatus @default(NOT_SENT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customer          Customer          @relation(fields: [customerId], references: [id])
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service           Service           @relation(fields: [serviceId], references: [id])
  staff             Staff?            @relation(fields: [staffId], references: [id])

  @@index([salonId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
}

model Shift {
  id        String    @id @default(cuid())
  salonId   String
  staffId   String?
  label     String
  type      ShiftType
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff     Staff?    @relation(fields: [staffId], references: [id])

  @@index([salonId, startsAt])
  @@index([staffId, startsAt])
}

model Notification {
  id        String    @id @default(cuid())
  salonId   String
  kind      String
  title     String
  body      String
  severity  String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, readAt])
}
